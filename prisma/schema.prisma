// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PUBLIC
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(PUBLIC)
  createdAt DateTime @default(now())
}

model SiteProject {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String
  tags        String[]
  emoji       String?
  gradient    String   @default("linear-gradient(135deg, #6c63ff 0%, #3ecfcf 100%)")
  image       String?
  gallery     String[]
  liveUrl     String?
  codeUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id        String   @id @default(cuid())
  title     String
  company   String
  dateRange String
  tasks     String[]
  tags      String[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalEndorsement {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  message   String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(80)
  category  String
  icon      String?
  emoji     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Legacy models kept for compatibility if needed
model CreativeShowcase {
  id          String   @id @default(cuid())
  title       String
  description String
  mediaUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechPath {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  repoUrl     String?
  liveUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
